# ==========================================
# DAAR Projet 2 - Configuration Docker
# ==========================================

# PostgreSQL
POSTGRES_DB=daar
POSTGRES_USER=daar_user
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_fort

# Corpus Gutenberg
# Archive du corpus de 1700 livres.
# Si cette variable est absente, Compose utilise
# son URL par defaut.
CORPUS_URL=https://github.com/ouumm/daar-corpus-public/releases/download/corpus-v1/corpus-1700.tar.gz

# Backend FastAPI
BACKEND_PORT=8000

# Frontend React/Vite (configuration locale P1)
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173

# Remarque :
# DB_HOST=db et DB_PORT=5432 sont transmis
# aux conteneurs par compose.yaml.
# Ils ne necessitent pas de configuration ici.
