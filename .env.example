# ==========================================
# DAAR Projet 2 - Configuration Docker
# ==========================================

# PostgreSQL
POSTGRES_DB=daar
POSTGRES_USER=daar_user

# Secrets Docker : chemins vers des fichiers NON versionnés (voir secrets/README.md).
# Sans ces lignes, les fichiers de développement secrets/*.dev sont utilisés.
# DB_PASSWORD_SECRET=./secrets/db_password.txt
# SMTP_PASSWORD_SECRET=./secrets/smtp_password.txt

# Corpus Gutenberg
# Archive du corpus de 1700 livres.
# Si cette variable est absente, Compose utilise
# son URL par defaut.
CORPUS_URL=https://github.com/ouumm/daar-corpus-public/releases/download/corpus-v1/corpus-1700.tar.gz

# Backend FastAPI
BACKEND_PORT=8000

# Frontend (nginx). 0.0.0.0 = accessible depuis les autres
# machines du reseau (demonstration multi-appareils).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173

# Remarque :
# DB_HOST=db et DB_PORT=5432 sont transmis
# aux conteneurs par compose.yaml.
# Ils ne necessitent pas de configuration ici.

# Graphe de Jaccard (service graph-init)
# Seuil de similarite pour relier deux livres.
GRAPH_THRESHOLD=0.20
# Un terme present dans plus de cette part du corpus est ignore.
GRAPH_MAX_DF=0.5
# Nombre minimal de voisins gardes pour chaque livre.
GRAPH_MIN_NEIGHBORS=5

# E-mails (confirmation d'inscription, mot de passe oublié).
# Sans SMTP_HOST, aucun e-mail n'est envoyé : les liens sont écrits dans les
# logs du backend (docker compose logs backend). Le mot de passe SMTP est un
# secret : SMTP_PASSWORD_SECRET ci-dessus.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=
